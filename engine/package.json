{
  "name": "@krat214/mnemo",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.3.0",
  "description": "Cooperative persistent memory for LLMs via MCP — episodes → memories → traits over SQLite (FTS5 + Hebbian recall)",
  "mcpName": "io.github.krat214/mnemo",
  "type": "module",
  "license": "MIT",
  "author": "Angel Renteria",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krat214/mnemo.git",
    "directory": "engine"
  },
  "homepage": "https://github.com/krat214/mnemo#readme",
  "bugs": {
    "url": "https://github.com/krat214/mnemo/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "memory",
    "llm",
    "agent-memory",
    "sqlite",
    "fts5",
    "claude",
    "persistent-memory"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "mnemo": "./dist/server.js",
    "mnemo-http": "./dist/server-http.js",
    "mnemo-ingest": "./dist/ingest-cli.js",
    "mnemo-consolidate": "./dist/consolidate-cli.js",
    "mnemo-forget": "./dist/forget-cli.js",
    "mnemo-migrate-engram": "./dist/migrate-engram-cli.js",
    "mnemo-stats": "./dist/stats-cli.js",
    "mnemo-embed": "./dist/embed-cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/server.ts",
    "dev:http": "tsx src/server-http.ts",
    "start": "node dist/server.js",
    "start:http": "node dist/server-http.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "better-sqlite3": "^12.11.1",
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.15.0"
}
