# Ruta de la base de datos SQLite (default: ~/.mnemo/mem.db)
MNEMO_DB=

# Credenciales obligatorias para el modo HTTP (npm run start:http)
MNEMO_AUTH_USER=
MNEMO_AUTH_PASS=

# Solo para desarrollo local sin auth — el servidor se rehúsa a arrancar sin esto
# si no configuraste MNEMO_AUTH_USER/MNEMO_AUTH_PASS. NUNCA lo actives en un servidor
# accesible desde internet.
MNEMO_ALLOW_NO_AUTH=

# Puerto del servidor HTTP (default: 3200)
PORT=

# Vida media (en días) de la relevancia (salience) antes de que decaiga a la mitad
MNEMO_SALIENCE_HALF_LIFE_DAYS=
